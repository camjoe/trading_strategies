# Private operator state, real strategy work, generated artifacts, logs, and databases.
local/*
.claude/output-styles/*

# Runtime databases and logs remain private regardless of where a tool writes them.
*.db
*.sqlite
*.sqlite3
*.log

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[co]

# Unit test / coverage reports
.coverage
.coverage.*
.cache
coverage.xml
.hypothesis/
.pytest_cache/

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/

# Claude local tooling
.claude/launch.json
.claude/settings.local.json

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff stuff:
.ruff_cache/

# Packaging / build artifacts (e.g. from `pip install -e .`)
*.egg-info/
build/
dist/
