{
  "schema_version": 1,
  "file": ".github/workflows/ci.yml",
  "name": "CI",
  "triggers": [
    {
      "event": "push",
      "branches": [
        "main",
        "develop"
      ]
    },
    {
      "event": "pull_request",
      "branches": []
    }
  ],
  "jobs": [
    {
      "id": "changes",
      "name": "changes",
      "needs": [],
      "runs_on": "ubuntu-latest",
      "condition": null,
      "always_on_push": false,
      "when_changed": [],
      "path_filters": {
        "python_related": [
          "src/**",
          "apps/trends/**",
          "apps/paper_trading_web/backend/**",
          "apps/paper_trading_web/__init__.py",
          "tests/**",
          "pytest.ini",
          "pyproject.toml",
          "ruff.toml",
          "requirements-base.txt",
          "requirements-dev.txt",
          ".github/workflows/ci.yml"
        ],
        "frontend_related": [
          "apps/paper_trading_web/frontend/**",
          ".github/workflows/ci.yml"
        ],
        "docs_enforcement_related": [
          "docs/**",
          "scripts/**",
          ".ai/**",
          "AGENTS.md",
          ".editorconfig",
          ".gitattributes",
          "apps/paper_trading_web/backend/routes/**",
          "apps/paper_trading_web/frontend/src/assets/**",
          "requirements-base.txt",
          "requirements-dev.txt",
          ".github/workflows/ci.yml"
        ]
      },
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v6",
          "run": null
        },
        {
          "name": "Detect quality gate scope",
          "uses": "dorny/paths-filter@v3",
          "run": null
        }
      ]
    },
    {
      "id": "python",
      "name": "python",
      "needs": [
        "changes"
      ],
      "runs_on": "ubuntu-latest",
      "condition": "github.event_name != 'pull_request' || needs.changes.outputs.python_related == 'true'",
      "always_on_push": true,
      "when_changed": [
        "python_related"
      ],
      "path_filters": {},
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v6",
          "run": null
        },
        {
          "name": "Set up Python",
          "uses": "actions/setup-python@v6",
          "run": null
        },
        {
          "name": "Install Python dependencies and quality tools",
          "uses": null,
          "run": "python -m pip install --upgrade pip\npip install -r requirements-dev.txt"
        },
        {
          "name": "Run Python lint, type, and test gates",
          "uses": null,
          "run": "python -m scripts.run_checks python"
        },
        {
          "name": "Upload coverage report",
          "uses": "actions/upload-artifact@v7",
          "run": null
        }
      ]
    },
    {
      "id": "frontend",
      "name": "frontend",
      "needs": [
        "changes"
      ],
      "runs_on": "ubuntu-latest",
      "condition": "github.event_name != 'pull_request' || needs.changes.outputs.frontend_related == 'true'",
      "always_on_push": true,
      "when_changed": [
        "frontend_related"
      ],
      "path_filters": {},
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v6",
          "run": null
        },
        {
          "name": "Set up Node.js",
          "uses": "actions/setup-node@v6",
          "run": null
        },
        {
          "name": "Install frontend dependencies",
          "uses": null,
          "run": "npm ci"
        },
        {
          "name": "Run frontend lint gate",
          "uses": null,
          "run": "npm run lint"
        },
        {
          "name": "Run frontend typecheck gate",
          "uses": null,
          "run": "npm run typecheck"
        },
        {
          "name": "Run frontend tests with coverage",
          "uses": null,
          "run": "npm run test:coverage"
        },
        {
          "name": "Upload frontend coverage report",
          "uses": "actions/upload-artifact@v7",
          "run": null
        }
      ]
    },
    {
      "id": "static-checks",
      "name": "static-checks",
      "needs": [
        "changes"
      ],
      "runs_on": "ubuntu-latest",
      "condition": "github.event_name != 'pull_request' || needs.changes.outputs.python_related == 'true' || needs.changes.outputs.frontend_related == 'true' || needs.changes.outputs.docs_enforcement_related == 'true'",
      "always_on_push": true,
      "when_changed": [
        "docs_enforcement_related",
        "frontend_related",
        "python_related"
      ],
      "path_filters": {},
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v6",
          "run": null
        },
        {
          "name": "Set up Python",
          "uses": "actions/setup-python@v6",
          "run": null
        },
        {
          "name": "Install Python dependencies",
          "uses": null,
          "run": "python -m pip install --upgrade pip\npip install -r requirements-dev.txt"
        },
        {
          "name": "Run documentation and safety enforcement",
          "uses": null,
          "run": "python -m scripts.run_checks docs\npython -m scripts.run_checks repo"
        }
      ]
    }
  ]
}
