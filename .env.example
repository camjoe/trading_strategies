# =============================================================================
# Runtime / broker / data environment template
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored; this `.env.example` is committed. Never commit secrets.
#
# SECRETS POLICY: create the real `.env` ONLY on the production Linux host,
# never in a dev checkout where coding agents run. `.gitignore` stops a file
# from being COMMITTED — it does NOT stop an agent/tool from READING it. The
# deterministic protection is the secrets not existing on the dev machine.
# On the prod host, `chmod 600 .env` and own it as the runtime user.
#
# IMPORTANT — how these are loaded:
#   - The RUNTIME JOBS (cron / Task Scheduler entrypoints under
#     trading.interfaces.runtime.*) read os.environ DIRECTLY. They do NOT
#     auto-load this file. You must export these into the job's environment.
#     On the Linux host, source this file from the cron wrapper or set the
#     vars in the crontab header. See docs/runbooks/production-runtime-host.md §1.3.
#   - The WEB BACKEND loads its own file: apps/paper_trading_web/backend/.env
#     (see apps/paper_trading_web/backend/.env.example). This file does not
#     feed the web app.
#
# To load this file into your current shell manually (POSIX):
#   set -a && . ./.env && set +a
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime alerts
# -----------------------------------------------------------------------------
# Webhook POSTed on job failure (and on success if --notify-on-success is passed).
# Used as the default for --notify-webhook-url by the daily paper-trading and
# trader-health jobs. Leave blank to disable notifications.
# Defined in src/trading/interfaces/runtime/jobs/job_helpers.py
TRADING_RUNTIME_ALERT_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Database (SQLite)
# -----------------------------------------------------------------------------
# Resolution order (src/infrastructure/database/config.py):
#   1. TRADING_DB_PATH  2. db_path in the config JSON  3. project default.
# Set an absolute path on the production host so cron jobs are unambiguous.
# TRADING_DB_PATH=/home/<user>/trading-prod/local/paper_trading.db
#
# Optional: path to a JSON file holding { "db_path": "..." } instead of the var above.
# TRADING_DB_CONFIG=/home/<user>/trading-prod/local/db_config.json


# -----------------------------------------------------------------------------
# Market data provider
# -----------------------------------------------------------------------------
# Provider selector + optional config path (src/infrastructure/market_data/factory.py).
# TRADING_MARKET_DATA_PROVIDER=
# TRADING_MARKET_DATA_CONFIG=
#
# Cache controls (src/infrastructure/market_data/cache.py).
# TRADING_MARKET_DATA_CACHE_DIR=
# TRADING_MARKET_DATA_CACHE_DISABLED=


# -----------------------------------------------------------------------------
# IBKR Web API (broker) — paper trading
# -----------------------------------------------------------------------------
# Precedence: these env vars first, then local/ibkr_web_api_config.json
# (src/infrastructure/brokers/ib_web/settings.py). Keep credentials out of git.
# See docs/reference/broker-setup-ibkr.md and docs/reference/broker-integration.md.
#
# REQUIRED: the IBKR account id to trade.
TRADING_IBKR_WEB_API_ACCOUNT_ID=
#
# Optional (sensible defaults exist for all of these):
# TRADING_IBKR_WEB_API_BASE_URL=
# TRADING_IBKR_WEB_API_HEADERS_JSON=
# TRADING_IBKR_WEB_API_SESSION_TOKEN=
# TRADING_IBKR_WEB_API_VERIFY_SSL=
# TRADING_IBKR_WEB_API_TIMEOUT_SECONDS=
# TRADING_IBKR_WEB_API_KEEPALIVE_ENABLED=
# TRADING_IBKR_WEB_API_KEEPALIVE_INTERVAL_SECONDS=
#
# Alternative to the vars above: point at a private JSON config file.
# TRADING_IBKR_WEB_API_CONFIG=/home/<user>/brokers/ibkr_web_api_config.json
