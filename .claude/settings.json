{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)"
    ]
  }
}
