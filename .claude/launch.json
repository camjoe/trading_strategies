{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "paper_trading_web.backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/paper_trading_web/frontend", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
